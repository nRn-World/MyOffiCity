# nRn Company – server-side keys. Copy to .env and fill in what you have.
# .env is gitignored and never leaves this computer.
# The browser never sees these values.

# OpenRouter (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# GitHub fine-grained token: Contents + Pull requests read/write, Metadata read.
# Add Administration read/write if the team should create new repositories.
GITHUB_TOKEN=

# Optional
OLLAMA_URL=http://localhost:11434
PORT=8765
